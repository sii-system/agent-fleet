# Agent Fleet — shared site configuration
#
# Single place to point the fleet at your own infrastructure (model gateway,
# Opik, package mirrors, container image). Most lines are commented out and
# ship with a public-safe placeholder or default. Package mirror defaults
# are uncommented below — override in config.local.env if needed.
#
# This committed template is sourced by the Harbor benchmark runner
# (Agents/utils/common/Harbor/env.sh), the OpenClaw setup
# (Agents/Openclaw/scripts/setup.sh), and the PinchBench and clawBio runners.
# An adjacent config.local.env
# (git-ignored) is sourced right after this file and overrides it. Uncommented
# values here override the built-in defaults; to override for a single run, pass
# an environment variable instead.
#
# Keep real secrets out of this committed file: put credentials (API_KEY)
# in config.local.env, or export them in your shell.

# ── Model gateway ─────────────────────────────────────────────────────────────
# OpenAI- or Anthropic-compatible endpoint and credential. BASE_URL is the API
# root WITHOUT a version suffix; the runners append /v1 (or /v1/chat/completions)
# as needed, so a URL already ending in /v1 also works.
# BASE_URL=https://api.example.com
# API_KEY=sk-your-key
# MODEL=your-model-id
# Harbor benchmark framework fixed-run generation controls. Temperature and
# top_p require OpenCode; DSH SDK minimal fixes both in its relay. Max tokens
# also applies to Claude Code, Pi, and DSH SDK minimal.
# HARBOR_TEMPERATURE=0.2
# HARBOR_TOP_P=0.9
# HARBOR_MAX_TOKENS=8192
# Pi task-container runtime. The package matches the control-plane Pi installed
# by scripts/setup.sh. PI_PROVIDER is optional: when unset it is derived from
# the BASE_URL host instead of a hard-coded placeholder name.
# PI_VERSION=0.81.1
# PI_PROVIDER=my-gateway
# PI_THINKING_LEVEL=high
# Import encoding of thinking levels. By default pi emits reasoning_effort toward
# the gateway (minimal maps to "low"; xhigh and max map to "max"). Set PI_SUPPORTS_REASONING_EFFORT=0
# to keep the old enabled/disabled-only behavior, or PI_THINKING_LEVEL_MAP to a
# JSON override like {"off": null, "max": "high"}.
# PI_SUPPORTS_REASONING_EFFORT=1
# PI_THINKING_LEVEL_MAP=
# Pi extensions: host directory of .ts plugins mounted read-only into the task
# container and auto-loaded by pi (-e). Defaults to Agents/Harbor-pi/extensions
# inside the repo; set PI_EXTENSION_SOURCE to use a different host path and
# PI_EXTENSION_DIR to change the container mount point.
# PI_EXTENSION_SOURCE=Agents/Harbor-pi/extensions
# PI_EXTENSION_DIR=/opt/tb-pi/extensions

# DeepSeek Harness sdk-minimal runtime. Node, DSH, Python, and the Python SDK
# are prepared once on the runner and mounted into Docker/OpenSandbox tasks.
# DSH_SDK_MINIMAL_PYTHON_RUNTIME_BASENAME=dsh-sdk-minimal-python3.12-runtime.tar.gz
# DSH_SDK_MINIMAL_CLI_VERSION=0.1.2-alpha.2
# DSH_SDK_MINIMAL_SOURCE_REF=dsh-v0.1.2-alpha.2
# DSH_SDK_MINIMAL_SOURCE_SHA=0a53fb55bea101816fa226bb964ae2bed71c343b
# Optional verified checkout fallback when the runner cannot reach GitHub HTTPS:
# DSH_SDK_MINIMAL_SOURCE_DIR=/path/to/deepseek-harness
# DSH_SDK_MINIMAL_MAX_TOKENS=65536
# DSH_PROVIDER=deepseek
# DSH_PERMISSION_MODE=danger-full-access
# DSH_CONTEXT_WINDOW=200000

# Harbor benchmark framework Fixer overrides. Shared BASE_URL, API_KEY, and MODEL remain the
# fallback; keep real credentials in config.local.env.
# HARBOR_FIXER_BASE_URL=https://api.example.com/v1
# HARBOR_FIXER_API_KEY=sk-your-key
# HARBOR_FIXER_MODEL=your-model-id
# HARBOR_FIXER_PI_BIN=pi
# HARBOR_FIXER_PI_PROVIDER=harbor-fixer
# HARBOR_FIXER_NO_PROXY=0
# HARBOR_FIXER_AGENT_TIMEOUT=900
# HARBOR_FIXER_EXECUTION_TIMEOUT=300
# HARBOR_FIXER_SUMMARY_LIMIT=4000
# HARBOR_FIXER_MAX_CONCURRENCY=4
# HARBOR_FIXER_MAX_TASK_SUMMARY_CHARS=24000
# HARBOR_FIXER_MAX_TASK_SUMMARIES_CHARS=400000

# ── qz (SII Inspire) E2B-compatible sandbox ──────────────────────────────────
# Set RL_ENVIRONMENT_TYPE=qz to run Harbor benchmark trials in qz sandboxes
# (https://qz-sbx-api.sii.edu.cn, an E2B-compatible control plane). The
# adapter (Agents/utils/common/Harbor/qz_e2b_sandbox.py) maps these onto the
# official e2b SDK. In a qz process, QZ_SANDBOX_*/SBX_* connection values
# override ambient cloud-E2B settings; E2B_API_KEY is only a fallback when no
# qz key is configured and its value is an sbx_-prefixed qz key. Keep the real
# key in config.local.env.
# RL_ENVIRONMENT_TYPE=qz
# SBX_API_KEY=sbx-your-key
# SBX_API_URL=https://qz-sbx-api.sii.edu.cn
# Select exactly one mode: a fixed platform Template for every trial, or a
# schema-v1 mapping that resolves each task to its own ready Template ID.
# QZ_SANDBOX_TEMPLATE=your_registered_template
# QZ_SANDBOX_TEMPLATE_MAP=/absolute/path/to/qz-templates.json
# Per-sandbox lifetime; the platform caps it at 4 hours (14400).
# QZ_SANDBOX_TIMEOUT_SEC=14400
# Real-agent runtime sources default to npmmirror on qz. Override the npm
# source with the shared NPM_CONFIG_REGISTRY setting below when needed.
# QZ_NODE_DIST_URL=https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.gz

# ── YiCloud OpenSandbox task images ──────────────────────────────────────────
# Set RL_ENVIRONMENT_TYPE=opensandbox to enable the YiCloud provider. When an
# explicit HARBOR_OPENSANDBOX_IMAGE_REF or Bundle Manifest is absent, the Harbor
# benchmark runner resolves the selected local task into a versioned service bundle,
# publishes each content-addressed image, and reuses existing Registry manifests.
# Registry credentials stay in ~/.docker/config.json after `docker login`.
# RL_ENVIRONMENT_TYPE=opensandbox
# Optional trusted model-request customization for rollout agents. Version 1
# supports headers.set. Keep deployment values in config.local.env; /run_trial
# requests cannot supply or override this configuration.
# MODEL_REQUEST_CONFIG_JSON={"version":1,"headers":{"set":{"X-Route-Key":"deployment-a"}}}
# Every Sandbox must belong to an explicit environment. Prefer the immutable
# environment ID in automation; the exact name is resolved and cross-checked
# when only the name is available.
# YICLOUD_SANDBOX_ENVIRONMENT_ID=env-xxxxxxxx-xxx
# YICLOUD_SANDBOX_ENVIRONMENT_NAME=your-sandbox-environment
# Match the current YiCloud prewarm-pool flavor. Harbor benchmark task.toml resource
# requests are not forwarded because a different flavor takes the cold path.
# YICLOUD_SANDBOX_CPU=2
# YICLOUD_SANDBOX_MEMORY=8Gi
# YICLOUD_SANDBOX_LIFECYCLE_MINUTES=120
# Scheduling readiness is separate from the Harbor benchmark framework's wider environment/agent setup
# ceiling. Pending state and platform reason are logged at the interval below.
# YICLOUD_SANDBOX_READY_TIMEOUT_SEC=300
# YICLOUD_SANDBOX_STATUS_LOG_INTERVAL_SEC=30
# Debug only: retain a Sandbox when environment start fails so the provider can
# inspect it. The log prints its ID; delete it manually after investigation.
# YICLOUD_SANDBOX_RETAIN_ON_START_FAILURE=0
# Debug only: retain a successfully completed trial's Sandbox until its platform
# lifecycle expires. Do not enable this for normal batch runs.
# YICLOUD_SANDBOX_RETAIN_AFTER_TRIAL=0
# The default remains HTTP. Selecting an S3 profile defaults this to auto:
# reuse immutable objects through anonymous reads, publish missing objects only
# when an optional project-local write config is available, and otherwise fall
# back to HTTP. Set s3 explicitly when S3 failure must be strict.
# YICLOUD_SANDBOX_UPLOAD_BACKEND=http
# Agent Fleet resolves this project-local profile after loading
# config.local.env. A profile binds the bucket, anonymous read origin, and
# prefix. Its sibling s3cfg is optional and is used only to publish a missing
# object; read-only users should omit it. Writer credentials need ListBucket
# restricted to this profile's prefix because some providers report an
# anonymous missing-object HEAD as 403, plus permission to publish objects.
# YICLOUD_SANDBOX_S3_PROFILE=provider-name
# Optional write credential for legacy unprofiled configuration. The bucket,
# anonymous read origin, and prefix remain required for S3-backed reads. Do not
# combine standalone values with a profile.
# YICLOUD_SANDBOX_S3_CONFIG=/absolute/path/to/s3cfg
# YICLOUD_SANDBOX_S3_BUCKET=bucket-cache
# URL that already addresses the bucket; must not contain credentials, query,
# or fragment. Sandbox object URLs append the content-addressed object key.
# YICLOUD_SANDBOX_S3_READ_ORIGIN=http://s3.internal.example/bucket-cache
# YICLOUD_SANDBOX_S3_PREFIX=agent-fleet-upload/v1
# YICLOUD_SANDBOX_S3_CACHE_ROOT=/data/harbor-runs/opensandbox-s3-cache
# YICLOUD_SANDBOX_S3_LOCK_ROOT=/data/harbor-runs/opensandbox-s3-locks
# YICLOUD_SANDBOX_S3_DOWNLOAD_TIMEOUT_SEC=1800
# YICLOUD_SANDBOX_S3_DIRECTORY_COMPRESSION=auto
# YICLOUD_SANDBOX_S3CMD=s3cmd
# Explicit HTTP rollback path supplied by the Sandbox service.
YICLOUD_SANDBOX_FAST_UPLOAD_ORIGIN=https://sandbox.yicloud.com.cn
# YICLOUD_SANDBOX_UPLOAD_TIMEOUT_SEC=1800
# The OCI Registry integration uses an externally provisioned Registry Project per benchmark and derives
# a repository per task. Do not configure a shared task-image repository.
# YICLOUD_HARBOR_HOST=harbor.example.internal
# YICLOUD_HARBOR_PROJECT=seta
# Current supplier ingress requires false; set 1 only after trusted TLS is
# configured on the host.
# YICLOUD_HARBOR_TLS_VERIFY=0
# HARBOR_OPENSANDBOX_BENCHMARK=seta
# HARBOR_OPENSANDBOX_IMAGE_CACHE_ROOT=/data/harbor-runs/opensandbox-images
# Optional prebuilt Bundle Manifest. The runner resolves its main image and skips
# automatic bundle/image preparation. Every service image must use the registry
# configured by YICLOUD_HARBOR_HOST. Keep this on H-local runtime storage.
# HARBOR_OPENSANDBOX_BUNDLE_MANIFEST=/data/harbor-runs/bundles/task.json
# HARBOR_OPENSANDBOX_IMAGE_PLATFORM=linux/amd64
# HARBOR_OPENSANDBOX_DOCKERHUB_MIRROR_PREFIX=m.daocloud.io/docker.io
# HTTP allows minimal base images without CA certificates to bootstrap APT;
# Release-file signatures still provide package metadata integrity checking.
# HARBOR_OPENSANDBOX_APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
# OpenSandbox image prebuild uses audited domestic defaults independently per
# package ecosystem. Override only the source that needs a different endpoint.
# HARBOR_OPENSANDBOX_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# HARBOR_OPENSANDBOX_NPM_REGISTRY=https://registry.npmmirror.com
# HARBOR_OPENSANDBOX_GOPROXY=https://goproxy.cn,direct
# HARBOR_OPENSANDBOX_GOSUMDB=sum.golang.google.cn
# HARBOR_OPENSANDBOX_CARGO_REGISTRY_URL=sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/
# HARBOR_OPENSANDBOX_RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
# HARBOR_OPENSANDBOX_RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
# Optional build-only GitHub Smart HTTP prefix. Git clone/fetch and recursive
# submodules are rewritten transiently; the URL is not persisted in the image.
# HARBOR_OPENSANDBOX_GITHUB_MIRROR_URL=https://github-mirror.example.internal/repos/
# Optional exact-origin rewrites have no public default.
# HARBOR_OPENSANDBOX_RUSTUP_INIT_URL=https://mirror.example/rustup-init.sh
# HARBOR_OPENSANDBOX_PYTORCH_INDEX_URL=https://mirror.example/pytorch
# Optional aggregate health endpoint for a privately operated source set. When
# it fails, dataset prebuild retries with the audited domestic defaults above.
# HARBOR_OPENSANDBOX_PACKAGE_SOURCE_HEALTH_URL=https://mirror.example/healthz
# HARBOR_OPENSANDBOX_BUILD_ARGS_JSON={}
# Task Dockerfiles may download upstream release artifacts in RUN instructions.
# After `proxy_on`, BuildKit receives the current shell proxy by default and
# uses host networking so a loopback proxy is reachable.  Set USE_PROXY=0 only
# when every required source is reachable without a proxy.
# HARBOR_OPENSANDBOX_BUILD_USE_PROXY=1
# HARBOR_OPENSANDBOX_BUILD_NETWORK=host
# Optional explicit BuildKit proxy.  It takes precedence over HTTP(S)_PROXY;
# use a host-local endpoint only when that local proxy is intended.
# HARBOR_OPENSANDBOX_BUILD_PROXY_URL=http://127.0.0.1:7890
# Dataset prebuild records each successfully resolved Registry Bundle under the
# local image cache. On later runs it verifies the current task hash against
# that record and skips the Registry request when they match. Set to 0 to
# restore Registry-authoritative cache lookup for every task.
# HARBOR_OPENSANDBOX_PREBUILD_USE_LOCAL_UPLOAD_CACHE=1
# Optional fast-resume mode: trust a target-scoped local uploaded-Bundle record
# by task identity without parsing or hashing the dataset. Use only when the
# dataset and Registry retention are known to be stable.
# HARBOR_OPENSANDBOX_PREBUILD_SKIP_HASH_VERIFICATION=0
# OpenSandbox dataset prebuild always prunes unused BuildKit cache once before
# a non-dry-run batch and periodically while active. Set the interval to 0 to
# disable only periodic GC. These options do not delete images, containers,
# volumes, or OCI Registry data.
# HARBOR_OPENSANDBOX_PREBUILD_GC_INTERVAL_SEC=1800
# HARBOR_OPENSANDBOX_PREBUILD_GC_MAX_USED_SPACE=500GB
# HARBOR_OPENSANDBOX_PREBUILD_GC_MIN_FREE_SPACE=300GB
# HARBOR_OPENSANDBOX_PREBUILD_GC_RESERVED_SPACE=100GB

# ── Opik (optional) ──────────────────────────────────────────────────
# OPIK_URL is the single switch for trace upload: set an endpoint to send
# traces, leave it empty to run without Opik. setup.sh asks for it and
# persists the answer.
# OPIK_URL=https://opik.example.com/api
# OPIK_PROJECT_NAME=

# ── Package mirrors ───────────────────────────────────────────────────────────
# Override these to use private or regional mirrors. When unset, the Harbor benchmark framework uses
# npmmirror for qz and npmjs for its other backends; standalone subsystems keep
# their own defaults.
PIP_INDEX_URL=https://pypi.org/simple/
# PIP_EXTRA_INDEX_URL=
# PIP_TRUSTED_HOST=
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# Docker-in-Docker registry mirrors for scripts/dind-run.sh.
# Use comma-separated values when multiple mirrors are available.
DIND_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://mirror.ccs.tencentyun.com
# Docker-in-Docker default address pools for nested bridge networks.
# Semicolon-separated multiple Docker daemon pool specs when needed.
DIND_DEFAULT_ADDRESS_POOLS=base=10.200.0.0/13,size=21
GO111MODULE=on
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
CARGO_REGISTRY_REPLACE_WITH=mirror
CARGO_REGISTRY_URL=sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/
