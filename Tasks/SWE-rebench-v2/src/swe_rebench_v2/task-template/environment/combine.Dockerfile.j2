{% set project_dir = "/{}".format(spec.repo.split("/")[1]) %}{# Adapted from https://github.com/SWE-rebench/SWE-rebench-V2/blob/c71902a8cf8d2b725f63d51f199f4d3e56f68d2d/combine.Dockerfile.j2 #}
FROM --platform=linux/amd64 {{ spec.install_config.image_name }}

RUN <<-DOCKER_RUN_EOF
    set -eux;
    git init {{ project_dir }};
    cd {{ project_dir }};
    git remote add origin https://github.com/{{ spec.clone_repo }};
    git fetch --depth 1 --no-tags origin '{{ spec.base_commit }}';
    git checkout -B main '{{ spec.base_commit }}';
    git remote remove origin;
    rm -rf .git/logs .git/ORIG_HEAD .git/FETCH_HEAD;
    chmod -R 777 {{ project_dir }};
    {%- for cmd in spec.install_config.install %}
    ( {{ cmd }} ) || true;
    {%- endfor %}
DOCKER_RUN_EOF

WORKDIR {{ project_dir }}
