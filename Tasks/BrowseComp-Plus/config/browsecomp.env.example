# BrowseComp-Plus works with no benchmark-specific configuration. The first
# run creates a private runtime and downloads data/index/model files under
# $AGENT_FLEET_CACHE_DIR/browsecomp-plus. Put only desired overrides in
# config.local.env; never put API keys in this example.

# Retrieval defaults: local Qwen3-Embedding-0.6B + published FAISS index.
# BROWSECOMP_INDEX_VARIANT=qwen3-embedding-0.6b
# BROWSECOMP_EMBEDDING_BACKEND=local
# BROWSECOMP_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# BROWSECOMP_EMBEDDING_REVISION=<model commit>
# BROWSECOMP_TOKENIZER_MODEL=Qwen/Qwen3-Embedding-0.6B
# BROWSECOMP_TOKENIZER_REVISION=<tokenizer commit>
# BROWSECOMP_CORPUS_DATASET=Tevatron/browsecomp-plus-corpus
# BROWSECOMP_CORPUS_REVISION=<dataset commit>
# BROWSECOMP_SEARCH_K=5
# BROWSECOMP_SNIPPET_MAX_TOKENS=512
# BROWSECOMP_TORCH_DTYPE=auto
# BROWSECOMP_MCP_PORT=8000
# BROWSECOMP_MCP_HOST_IP=172.17.0.1  # auto-detected from Docker's bridge by default
# BROWSECOMP_MCP_PUBLIC_URL=http://172.17.0.1:8000/mcp
# BROWSECOMP_MCP_WAIT_SECONDS=1800
# BROWSECOMP_PI_AUTO_CONTINUE_COMPACTION=1
# BROWSECOMP_ENVIRONMENT_TYPE=docker
# BROWSECOMP_DETACHED_TIMEOUT_SECONDS=172800

# Optional host-side OpenAI-compatible embedding endpoint. FAISS and corpus
# remain local; this mode does not load local embedding weights. The endpoint
# must produce vectors compatible with the pinned Qwen3-Embedding-0.6B index.
# BROWSECOMP_EMBEDDING_BACKEND=openai
# BROWSECOMP_EMBEDDING_BASE_URL=https://embedding.example.com/v1
# BROWSECOMP_EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
# BROWSECOMP_EMBEDDING_API_MODEL=Qwen/Qwen3-Embedding-0.6B
# BROWSECOMP_EMBEDDING_API_TIMEOUT_SECONDS=60
# BROWSECOMP_EMBEDDING_API_MAX_RETRIES=2
# Direct is the default, matching Fleet's model-gateway policy. Set inherit
# only when the embedding endpoint must be reached through HTTP(S)_PROXY.
# BROWSECOMP_EMBEDDING_PROXY_MODE=direct

# Reuse a fully populated cache without any Hugging Face network access.
# BROWSECOMP_OFFLINE=1
# Hugging Face connectivity only: auto probes inherited proxy then direct.
# BROWSECOMP_HF_PROXY_MODE=auto
# Optional standard Hugging Face endpoint override. The default remains the
# official service; use a trusted mirror only when your network requires it.
# HF_ENDPOINT=https://hf-mirror.com

# Default: collect official-format answers without an LLM judge.
# Remote judging automatically reuses BASE_URL, API_KEY, and MODEL unless a
# dedicated judge endpoint/model/key environment variable is supplied.
# BROWSECOMP_JUDGE_MODE=openai
# BROWSECOMP_JUDGE_MODEL=Qwen/Qwen3-32B
# BROWSECOMP_JUDGE_BASE_URL=https://judge.example.com/v1
# BROWSECOMP_JUDGE_API_KEY_ENV=API_KEY
# BROWSECOMP_JUDGE_API_MODE=chat-completions
# Match Agent Fleet's default direct connection to its model gateway. Set
# inherit only when the judge endpoint must be reached through HTTP(S)_PROXY.
# BROWSECOMP_JUDGE_PROXY_MODE=direct

# Advanced cache/custom-asset overrides. Normal users should leave these unset.
# BROWSECOMP_CACHE_ROOT=/data/agent-fleet-cache/browsecomp-plus
# BROWSECOMP_GROUND_TRUTH=/data/private/browsecomp_plus_decrypted.jsonl
# BROWSECOMP_INDEX_PATH=/data/indexes/qwen3-embedding-0.6b/corpus.shard*.pkl
